<?xml version="1.0" encoding="utf-8"?>
<!--
  Flag Maker: every text a player reads, in French, translated from en.xml (the source for every
  translation). Made with AI: corrections from native speakers are welcome.

  To translate: copy en.xml, name it with the game's code for your language (de.xml, es.xml,
  fr.xml, ko.xml, pl.xml, pt.xml, ru.xml, zh.xml), set code and name below, and translate the
  text between the tags. Leave the keys alone.

  - {0}, {1}... are filled in by the mod (a number, a name). Keep every one of them.
  - A long text can be wrapped over several lines here: the break reads as one space.
  - \n is a real line break (used in the dialogs).
  - A key missing from a translation shows in English, so a partial translation works.

  The game's own words and this mod's: flag = drapeau, flagpole = mât, cloth = tissu, pattern =
  motif, corner box = carré d'angle, Images folder = dossier Images (its name on disk). Wind = vent,
  gust = rafale, breeze = brise, and the wind's names as Volumetric Weather has them (calme,
  brise, tempête, coup de vent); Fixed = Fixe. Info view = vue Infos, as Real Glass has. "Vous",
  a space before : ; ? ! as Real Glass has. Move It, Unified UI, Volumetric Weather, Procedural
  Objects, Extended Managers Library and Prop Anarchy stay in English.
-->
<Language code="fr" name="Français">

  <!-- ==================== The mod ==================== -->

  <!-- One line in the game's mods list: about 30 characters fit before it wraps. -->
  <String key="Mod.Description">Drapeaux entièrement animés et personnalisables</String>
  <String key="Mod.Unsupported">
    Flag Maker ne peut pas afficher les drapeaux sur cet ordinateur : il lui faut Metal ou
    OpenGL 3.3. Vos drapeaux restent sauvegardés dans la ville.
  </String>
  <String key="Mod.UnsupportedWindows">
    Flag Maker ne peut pas afficher les drapeaux sur cet ordinateur : il lui faut DirectX 11.
    Vos drapeaux restent sauvegardés dans la ville.\n\n
    Supprimez toute option de lancement graphique (Steam : Propriétés, Options de lancement)
    puis redémarrez.\n\n
    Toujours bloqué ? Signalez-le avec le journal :\n{0}
  </String>
  <String key="Mod.UnsupportedLinux">
    Flag Maker ne peut pas afficher les drapeaux sur cet ordinateur : il lui faut OpenGL 3.3.
    Vos drapeaux restent sauvegardés dans la ville.\n\n
    Ou lancez la version Windows du jeu avec Proton.\n\n
    Merci de signaler le problème avec le journal :\n{0}
  </String>

  <!-- A city whose flags this copy of the mod must leave alone: it stands down in the city, and
       the flags' saved designs are written back exactly as they were loaded. -->
  <String key="Mod.KeptUnreadable">
    Flag Maker ne peut pas lire les drapeaux de cette ville (sauvegardés par une version plus
    récente, ou abîmés). Le mod reste désactivé ici ; sauvegarder garde les drapeaux tels quels.\n\n
    Redémarrez le jeu pour que Steam mette le mod à jour.\n\n
    Toujours bloqué ? Signalez-le avec le journal :\n{0}
  </String>
  <String key="Mod.KeptEml">
    Flag Maker ne gère pas encore Extended Managers Library (utilisé par Prop Anarchy). Il reste
    désactivé ici ; sauvegarder garde les drapeaux tels quels.
  </String>
  <String key="Mod.KeptLost">
    Flag Maker a perdu {0} drapeau(x) de cette ville pendant le chargement. Ne sauvegardez pas :
    quittez, redémarrez le jeu et rechargez.\n\n
    Toujours manquants ? Signalez-le avec le journal :\n{1}
  </String>

  <!-- Procedural Objects' or Move It's "Convert to PO" on a flag: refused, the flag left as it is. -->
  <String key="Mod.NoProcedural">Les drapeaux ne peuvent pas devenir des Procedural Objects. Ils restent tels quels.</String>
  <String key="Mod.CrowdLoop">
    Beaucoup de drapeaux flottants proches les uns des autres ralentissent le jeu : ici, les
    nouveaux sont donc placés en Boucle, presque pareil à l'œil et presque gratuit.\n\n
    Vous les voulez flottants ? Choisissez Flottant dans la fenêtre Nouveau drapeau, ou désactivez
    Placer les foules en boucle dans Réglages.
  </String>

